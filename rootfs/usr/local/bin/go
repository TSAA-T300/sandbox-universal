#!/bin/sh
# go 的包裝：執行前把編譯快取的「上次清理時間」記為現在，讓 go 不清理快取。
# go 每次建置結束時，如果距離上次清理超過一天，會刪掉 5 天沒用到的快取項目（上次清理時間記在快取目錄的 trim.txt）。
# 映像預建的標準函式庫快取（/work/.cache/go-build）一定超過 5 天：不處理的話，每個沙盒第一次建置結束時，這次沒用到的
# 部分都會被刪掉，之後用到其他套件的程式要重新編譯（2026-11-14 在 1 核的沙盒實測：同一支程式由 0.5 秒變成 2.9 秒）。
# 沙盒的快取隨沙盒一起消失，不需要清理。trim.txt 不存在或不可寫時（例如自訂了 GOCACHE）不做任何事。
# 先寫到暫存檔再改名：同時有另一個 go 在跑時，它不會讀到寫到一半的空檔（讀不出時間的話 go 會照樣清理）。
trim="${GOCACHE:-${HOME:-/work}/.cache/go-build}/trim.txt"
if [ -w "$trim" ]; then
    date +%s > "$trim.$$" 2> /dev/null && mv -f "$trim.$$" "$trim" 2> /dev/null
fi
exec /usr/bin/go "$@"
