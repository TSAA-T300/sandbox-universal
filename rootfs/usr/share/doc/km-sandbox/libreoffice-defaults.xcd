<?xml version="1.0" encoding="UTF-8"?>
<!--
  km-sandbox 的 LibreOffice 預設值：中日韓文字的預設文件語言設為繁體中文（台灣）。
  建置時複製到 LibreOffice 的 share/registry/（對所有 user profile 生效，包含以 -env:UserInstallation 另指的 profile）。

  文件沒有指定中日韓字型、也沒有標示語言時（python-pptx、openpyxl、docx-js、pptxgenjs 的預設輸出都是），LibreOffice 以
  「預設文件語言」決定要哪個地區的字形；語系是 C.UTF-8 時它預設成簡體中文，轉出的 PDF 會用到 Noto Sans CJK 的 SC 變體。
  2026-11-13 實測：加上這項設定後，上述四種文件轉出的 PDF 都內嵌 TC 變體。
  文件自己指定了字型但映像沒有那個字型時（python-docx 與 pandoc 的預設範本），替代字型由 fontconfig 決定，
  不受這項設定影響，靠 /etc/km-sandbox/env.sh 的 FC_LANG。
-->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
  <dependency file="main"/>
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Linguistic">
    <node oor:name="General">
      <prop oor:name="DefaultLocale_CJK">
        <value>zh-TW</value>
      </prop>
    </node>
  </oor:component-data>
</oor:data>
